  "cards": [
    {
      "dot": "cyan",
      "title": "Where the answer key comes from",
      "items": [
        "Nobody hand-drew these outlines: a fixed rule reads the magnetic map",
        "Strong patches that are all one polarity are deliberately left unmarked",
        "The rule's settings are choices, so the answer key has its own wobble"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the baseline matters",
      "items": [
        "The baseline has only 14 numbers and cannot memorise anything",
        "It sees the same pictures and is judged by the same scorecard",
        "Surya's score only means something as a gap above this line"
      ]
    },
    {
      "dot": "amber",
      "title": "Why overlap, not accuracy",
      "items": [
        "Active regions cover roughly 1% of the visible disk",
        "Answering 'nothing anywhere' scores about 99% correct and is useless",
        "Overlap between guessed and true outlines is the honest measure"
      ]
    }
  ]
